<?xml version="1.0" encoding="utf-8"?>
<!--
  Tela de apps recentes: a lista, e uma linha de texto no pé.

  Sem cabeçalho, de propósito. A busca e as configurações têm título porque são
  telas de consulta; esta é uma lista, como a tela inicial, e a tela inicial não
  tem. O padding superior de clock_list_gap é o mesmo respiro que separa o
  relógio da lista lá em cima, então a primeira linha não gruda no status bar.

  A linha do pé (recent_hint) é o mesmo estilo AppNameText das outras linhas, e
  serve para os três estados que não são lista: falta a permissão de uso, não há
  app recente, e Shizuku parado. Ela fica escondida na maioria do tempo.
-->
<com.minimal.launcher.EdgeGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recent_apps_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:contentDescription="@string/recent_list_description"
            android:overScrollMode="never"
            android:paddingTop="@dimen/clock_list_gap"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/recent_hint"
            style="@style/AppNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

</com.minimal.launcher.EdgeGestureLayout>