<?xml version="1.0" encoding="utf-8"?>
<com.minimal.launcher.EdgeGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/manage_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/manage_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:text="@string/manage_favorites_title"
            android:textColor="@color/fg_dark"
            android:textSize="@dimen/settings_title_size" />

        <TextView
            android:id="@+id/manage_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="@string/manage_favorites_hint"
            android:textColor="@color/fg_dark"
            android:textSize="@dimen/settings_summary_size" />

        <TextView
            android:id="@+id/manage_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="@string/manage_favorites_empty"
            android:textColor="@color/fg_dark"
            android:textSize="@dimen/app_name_size"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/favorites_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/header_bottom_padding"
            android:paddingTop="@dimen/header_bottom_padding">

            <TextView
                android:id="@+id/action_add"
                style="@style/AppNameText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/manage_favorites_add" />

            <TextView
                android:id="@+id/action_done"
                style="@style/AppNameText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/manage_favorites_done" />
        </LinearLayout>
    </LinearLayout>

</com.minimal.launcher.EdgeGestureLayout>