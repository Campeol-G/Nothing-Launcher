<?xml version="1.0" encoding="utf-8"?>
<!--
  Relógio (clock + date + indicador) fixo no topo; a lista de favoritos ocupa
  o resto. Nada de container rolável envolvendo o relógio: ele nunca rola.
-->
<com.minimal.launcher.EdgeGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:textColor="@color/fg_dark"
            android:textSize="@dimen/clock_size" />

        <TextView
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/clock_date_gap"
            android:fontFamily="sans-serif-light"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:textColor="@color/fg_dark"
            android:textSize="@dimen/date_size" />

        <View
            android:id="@+id/notification_dot"
            android:layout_width="@dimen/notification_dot_size"
            android:layout_height="@dimen/notification_dot_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/notification_dot_margin"
            android:background="@drawable/notification_dot"
            android:contentDescription="@string/pref_notification_dot_title"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/favorites_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/favorites_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:clipToPadding="false"
            android:contentDescription="@string/favorites_list_description"
            android:overScrollMode="never"
            android:scrollbars="none" />
    </FrameLayout>

</com.minimal.launcher.EdgeGestureLayout>