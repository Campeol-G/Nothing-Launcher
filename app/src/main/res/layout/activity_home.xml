<?xml version="1.0" encoding="utf-8"?>
<!--
  Bloco de hora e data no topo, com altura fixa em fração da tela (ver
  LauncherUtils.getHeaderHeightPx) — o relógio é o elemento principal e ocupa a
  faixa de cima de ponta a ponta.

  O relógio usa autoSize dentro do espaço que sobra no bloco, então preenche a
  faixa qualquer que seja o formato: 24h, 12h com AM/PM, ou um idioma que estoure
  a largura.

  A lista de favoritos é centralizada no espaço ABAIXO do bloco, e não na tela
  inteira: o deslocamento é um translationY de meia altura do cabeçalho, que é a
  correção exata para o centro.

  Nada de layout_weight: o EdgeGestureLayout é um FrameLayout, e o atributo seria
  ignorado — foi o que deixou a lista invisível numa versão anterior.
-->
<com.minimal.launcher.EdgeGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:letterSpacing="0.22"
            android:textSize="@dimen/date_size" />

        <!--
          maxLines sem singleLine, de propósito.

          singleLine="true" no Android também liga ellipsize=END e
          horizontallyScrolling. Com os dois ligados o autoSize deixa de encolher o
          texto e o horário aparece cortado como "19:...". maxLines sozinho deixa
          o autoSize fazer o trabalho dele, que é nunca cortar.
        -->
        <TextView
            android:id="@+id/clock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="none"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:maxLines="1" />

        <!--
          Só existe no formato empilhado: 18 em cima, 02 embaixo. Escondido, ele
          some do cálculo de peso e o relógio de cima fica com a faixa inteira.
        -->
        <TextView
            android:id="@+id/clock_minutes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="none"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:maxLines="1"
            android:visibility="gone" />
    </LinearLayout>

    <!--
      Ancorada logo abaixo do bloco do relógio, e não centralizada: o gravity é
      top e a distância vem de uma margem superior igual à altura do cabeçalho
      mais a folga. Antes era center_vertical com um translationY de meia altura
      do cabeçalho, que centralizava a lista no meio da tela e deixava o relógio
      longe dela.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/favorites_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipToPadding="false"
        android:contentDescription="@string/favorites_list_description"
        android:overScrollMode="never"
        android:scrollbars="none" />

</com.minimal.launcher.EdgeGestureLayout>
