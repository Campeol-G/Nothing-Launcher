<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Escala tipográfica. Cada valor é multiplicado pelo ajuste automático de
      tela (LauncherUtils.getFontFactor) e depois pelo passo escolhido nas
      Configurações.

      Não há tamanho de relógio aqui: o relógio usa autoSize para preencher a
      faixa que sobra no bloco de hora e data, e seu teto vem da altura da tela.
    -->
    <dimen name="date_size">15sp</dimen>
    <dimen name="app_name_size">22sp</dimen>
    <dimen name="search_result_size">28sp</dimen>
    <dimen name="search_size">22sp</dimen>
    <dimen name="settings_title_size">28sp</dimen>
    <dimen name="settings_row_size">17sp</dimen>
    <dimen name="settings_summary_size">13sp</dimen>

    <dimen name="header_bottom_padding">18dp</dimen>
    <dimen name="clock_date_gap">4dp</dimen>
    <!-- Folga entre o fim do bloco do relógio e o começo da lista. -->
    <dimen name="clock_list_gap">20dp</dimen>
    <dimen name="app_row_padding">10dp</dimen>

    <!--
      Tela de apps recentes: maior que a lista de favoritos, e com mais respiro.

      A lista de apps abertos é curta e a tela é grande. Com o mesmo corpo da
      lista de favoritos, sobraria metade da tela vazia. Estes dois tamanhos e o
      padding da linha são o que preenchem a tela sem nada parecer um botão.
    -->
    <dimen name="recent_app_name_size">28sp</dimen>
    <dimen name="recent_dismiss_size">20sp</dimen>
    <dimen name="recent_row_padding">16dp</dimen>
    <dimen name="recent_footer_padding">18dp</dimen>
    <!-- Respiro entre a última linha da lista e o botão que fica embaixo. -->
    <dimen name="recent_list_bottom_padding">6dp</dimen>
    <!--
      O "Limpar tudo" tem o mesmo corpo do nome: menor que isso, um botão do
      mesmo importance ao lado de linhas parecidas fica com cara de nota de rodapé.
      A dica é texto de apoio e continua menor — ela informa, não convida a tocar.
    -->
    <dimen name="recent_clear_all_size">28sp</dimen>
    <dimen name="recent_clear_all_top_padding">10dp</dimen>
    <dimen name="recent_hint_size">17sp</dimen>
    <dimen name="search_bar_top_margin">10dp</dimen>
    <dimen name="search_bar_inner_padding">14dp</dimen>
    <dimen name="search_more_top_padding">2dp</dimen>
    <dimen name="search_footer_padding">6dp</dimen>
    <dimen name="settings_row_padding_v">14dp</dimen>
    <dimen name="settings_section_padding">26dp</dimen>
</resources>
