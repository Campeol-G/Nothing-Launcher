<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Base única com `parent` explícito: sem isso o AndroidStudio aplicaria a
      herança implícita por nome (Theme.MinimalLauncher.* -> Theme.MinimalLauncher)
      e as variantes v27/v31 virariam um ciclo.
    -->
    <style name="Theme.MinimalLauncher.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentTransitions">false</item>
    </style>

    <style name="Theme.MinimalLauncher" parent="Theme.MinimalLauncher.Base" />

    <!--
      Lista de apps: só o nome. A fonte é aplicada em código, porque depende
      da combinação escolhida em FontCombo.
    -->
    <style name="AppNameText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/app_name_size</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingTop">@dimen/app_row_padding</item>
        <item name="android:paddingBottom">@dimen/app_row_padding</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
