<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Base única com `parent` explícito: sem isso o AndroidStudio aplicaria a
      herança implícita por nome (Theme.MinimalLauncher.* -> Theme.MinimalLauncher)
      e as variantes v27/v31 virariam um ciclo.
    -->
    <style name="Theme.MinimalLauncher.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Minimalismo: sem animação de abertura/fechamento de activity. -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <style name="Theme.MinimalLauncher" parent="Theme.MinimalLauncher.Base" />

    <!-- Lista de apps: só o nome, fonte fina. -->
    <style name="AppNameText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/app_name_size</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingTop">@dimen/app_row_padding</item>
        <item name="android:paddingBottom">@dimen/app_row_padding</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="RowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/settings_row_size</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:paddingTop">@dimen/settings_row_padding_v</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="RowSummary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/settings_summary_size</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:paddingBottom">@dimen/settings_row_padding_v</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
</resources>