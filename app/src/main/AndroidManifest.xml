<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Uso pessoal: Needed to list and launch every installed app. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      Acesso à API do Shizuku, em nível normal. É o app que pede permissão ao
      Shizuku, não o servidor.

      Esta permissão NÃO é a que protege o provider abaixo: ela é a que o nosso
      app precisa ter para poder pedir consentimento.
    -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Para o aviso da tela de recentes abrir a página do Shizuku. -->
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="android.intent.action.DELETE" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <!--
      Sem serviços e sem permissões especiais. O launcher não lê notificações:
      elas continuam sendo tratadas pelo sistema e aparecem quando o usuário
      puxa a barra. Nada de acesso a notificações, nada de acessibilidade.
    -->
    <application
        android:name=".LauncherApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.MinimalLauncher">

        <!-- ============================================================
             Launcher: HOME + DEFAULT + LAUNCHER + singleTask.
             Trocar o launcher padrão funciona pelo filtro HOME.
             ============================================================ -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.MinimalLauncher"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SearchActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MinimalLauncher"
            android:windowSoftInputMode="adjustNothing|stateAlwaysVisible" />

        <activity
            android:name=".settings.SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MinimalLauncher"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- ============================================================
             Tela de apps recentes.

             Sem CATEGORY_LAUNCHER, de propósito: é isso que a mantém fora da
             lista de apps do launcher e da busca, já que as duas listam o que
             tem essa categoria. O atalho do sistema a alcança por intent
             explícito, que não depende de filtro.

             Não está com excludeFromRecents como as outras telas porque ela é
             justamente a tela que substitui o recents na prática do usuário —
             escondê-la de lá tiraria do gesto de voltar.
             ============================================================ -->
        <activity
            android:name=".recents.RecentAppsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MinimalLauncher"
            android:windowSoftInputMode="adjustNothing" />

        <!--
          Shizuku: o provider é o que adquire o binder. Declarado à mão porque o
          artefato dev.rikka.shizuku:provider não o declara no manifesto dele.

          A permissão deste provider NÃO é a API_V23. Tem que ser
          INTERACT_ACROSS_USERS_FULL, e a diferença não é decorativa: é o próprio
          shizuku_server, que roda com identidade de shell, que precisa abrir este
          provider para falar com o gerenciador e mostrar o diálogo de consentimento.
          Com API_V23 aqui, o shell não tem a permissão e a abertura é negada com
          "Permission Denial", e o consentimento nunca chega a aparecer.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            tools:replace="android:permission" />
    </application>

</manifest>
